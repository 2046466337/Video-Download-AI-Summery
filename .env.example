DEEPSEEK_API_KEY = 

# ===================== Stripe 真实支付配置 =====================
# 把下面 3 个密钥填上，支付就切到 Stripe 真实模式了。去哪拿见注释。

# 支付模式：stripe = 真实支付；mock = 本地模拟（无需密钥）
PAYMENT_MODE=stripe

# 【密钥1】Stripe 后端密钥，测试模式以 sk_test_ 开头
# 去哪拿：dashboard.stripe.com → 右上角 Developers → API keys → Secret key
STRIPE_SECRET_KEY=

# 【密钥2】Webhook 签名密钥，以 whsec_ 开头
# 去哪拿：本地运行 stripe listen 后，终端会打印一行 whsec_xxx
STRIPE_WEBHOOK_SECRET=

# 【密钥3】价格对象 ID，以 price_ 开头
# 去哪拿：dashboard.stripe.com → 产品目录(Product catalog) → 添加产品 → 建价格
STRIPE_PRICE_ID=

# 支付完成/取消后跳回的前端地址（改成你实际打开浏览器的地址）
# 后端托管(8000)就填 http://localhost:8000；用 vite dev(5173)就填 http://localhost:5173
SITE_URL=http://localhost:8000

# 单次购买解锁的天数
MEMBERSHIP_DAYS=30